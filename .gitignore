.DS_Store
*.log

# Prompt version snapshots — local rollback safety net (see scripts/prompt-version.sh).
# Ignore the snapshot bodies but keep the per-agent HISTORY.md logs + README tracked.
versions/*/*/

# Raya deploy secrets — never commit the base URL/token (see raya/README.md).
# The tracked twin is raya/.env.example (keys only, no values).
.env
raya/.env

# Google service-account key (Sheets API) — never commit.
secrets/
*service-account*.json
gsheets-sa.json

# Scratch / temp working files
scratchpad/
scratchpad_*

# Tool-config snapshots contain live API keys in headers — never commit
raya/snapshots/
